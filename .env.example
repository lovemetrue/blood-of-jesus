# Образец окружения для bloodofjesus.ru. Скопируйте в .env рядом с
# docker-compose.prod.yml и заполните значения:  cp .env.example .env
#
# Файл .env читают и docker compose (подстановка ${...}), и Django через
# python-decouple. Реальный .env в git не коммитится.

# ========== Django ==========
SECRET_KEY=замените-на-случайную-строку-минимум-50-символов
DEBUG=False
ALLOWED_HOSTS=bloodofjesus.ru,www.bloodofjesus.ru,localhost,127.0.0.1
SITE_URL=https://bloodofjesus.ru
USE_HTTPS=True
CORS_ORIGINS=https://bloodofjesus.ru,https://www.bloodofjesus.ru
# Уровень логов приложения (main.*): DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# ========== PostgreSQL ==========
POSTGRES_DB=liberation_db
POSTGRES_USER=liberation_user
POSTGRES_PASSWORD=замените-на-стойкий-пароль
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ========== Valkey (кэш и сессии) ==========
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# ========== Почта ==========
# БЕЗ ЭТОГО БЛОКА ПИСЬМА С ФОРМЫ ОБРАТНОЙ СВЯЗИ НЕ УХОДЯТ.
# По умолчанию Django настроен на console.EmailBackend — заглушку, которая
# печатает письмо в лог контейнера и ничего не отправляет. Заявка при этом
# сохраняется в БД и видна в /admin/, поэтому снаружи всё выглядит рабочим.
#
# Порт 465 -> EMAIL_USE_SSL=True,  EMAIL_USE_TLS=False
# Порт 587 -> EMAIL_USE_SSL=False, EMAIL_USE_TLS=True
# EMAIL_HOST_PASSWORD — «пароль приложения» из Яндекс 360, не пароль аккаунта.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=jesusthehealer@yandex.ru
EMAIL_HOST_PASSWORD=пароль-приложения-яндекс-360
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=jesusthehealer@yandex.ru
# Куда приходят уведомления о новых заявках с формы
CONTACT_NOTIFY_EMAIL=jesusthehealer@yandex.ru
# Адрес «напишите нам», который показывается посетителю
CONTACT_REPLY_ADDRESS=jesusthehealer@yandex.ru
ADMIN_EMAIL=jesusthehealer@yandex.ru

# Проверка после заполнения:
#   docker compose -f docker-compose.prod.yml exec backend \
#     python manage.py send_test_contact_email ваш@email.ru
# Команда печатает разобранный конфиг, проверяет соединение с SMTP и
# завершается с кодом 1, если письмо не ушло.

# ========== ЮKassa ==========
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ========== Деплой (docker-compose.prod.yml) ==========
DOCKERHUB_IMAGE=пользователь/репозиторий
IMAGE_TAG=main
